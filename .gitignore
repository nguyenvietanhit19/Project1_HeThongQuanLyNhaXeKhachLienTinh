# Environment variables — bài học từ bản v1: file .env.py từng bị lộ vì .gitignore
# chỉ có pattern *.env, không khớp .env.py. Chặn mọi biến thể ở đây.
.env
.env.*
*.env
!.env.example
!*.env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# IDE — .vscode/settings.json là cấu hình dùng chung cho cả nhóm (VD gốc Live
# Server), NÊN commit; các file cá nhân khác trong .vscode/ vẫn bị chặn.
.vscode/*
!.vscode/settings.json
.idea/

# OS
.DS_Store
Thumbs.db

# Logs
*.log
