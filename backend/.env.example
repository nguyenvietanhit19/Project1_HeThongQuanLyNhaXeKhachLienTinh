# Database (Supabase Postgres cho production; docker-compose db cho local dev)
DATABASE_URL=postgresql://postgres:postgres_dev_only@db:5432/nha_xe

# JWT
JWT_SECRET=change_me_to_a_long_random_string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Brevo API — gửi mã OTP đăng ký/quên mật khẩu qua HTTPS (NGHIEP_VU.md
# mục 2.1). Trước dùng Gmail SMTP thô nhưng bị chặn/timeout khi deploy
# (Render free tier không hỗ trợ IPv6 + Google chặn SMTP trực tiếp từ IP
# cloud) — xem lịch sử commit email_service.py. Lấy API key tại
# brevo.com → Settings → SMTP & API → API Keys. BREVO_SENDER_EMAIL phải
# là email đã xác thực tại Senders, Domains & Dedicated IPs → Senders
# (verify qua link gửi tới hộp mail đó, không cần domain riêng).
BREVO_API_KEY=xkeysib-your-api-key
BREVO_SENDER_EMAIL=your_verified_sender@gmail.com

# VNPay sandbox (thanh toán + hoàn tiền — NGHIEP_VU.md mục 6-7)
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:8000/thanh-toan/callback

# App
APP_ENV=development
# localhost và 127.0.0.1 là 2 "origin" khác nhau với trình duyệt dù cùng
# trỏ về máy mình — liệt kê cả 2 để tránh lỗi "Failed to fetch" tùy theo
# cách bạn mở frontend (VD VS Code Live Server mặc định dùng 127.0.0.1).
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
