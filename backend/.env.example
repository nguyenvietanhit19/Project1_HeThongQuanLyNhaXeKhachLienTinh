# Cấu hình kết nối PostgreSQL trong Docker container (host: 'db')
DATABASE_URL=postgresql://postgres:postgres_dev_only@db:5432/nha_xe

# Cấu hình JWT (xác thực đăng nhập)
JWT_SECRET=bi_mat_jwt_dev_khong_dung_tren_production_123456
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Danh sách domain Frontend được phép gọi API (CORS)
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8000

# Cấu hình gửi mail OTP qua Gmail SMTP (để trống nếu chưa test gửi mail thật)
